# URL de conexão PostgreSQL
# App (pooled, com -pooler no host): tráfego da API
# Local:  postgres://postgres:SUA_SENHA@localhost:5432/digitar_pro
# Neon:   postgresql://USER:PASSWORD@HOST-pooler.../neondb?sslmode=require
DATABASE_URL=postgres://postgres:SUA_SENHA_AQUI@localhost:5432/digitar_pro

# Migrações (direta, sem -pooler). O `neon env pull` / `neon deploy` preenche as duas.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.../neondb?sslmode=require

# SSL explícito (Neon já detecta por host/sslmode; use true se necessário)
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Porta do servidor HTTP + API (apenas `npm start` local)
PORT=3000

# Origem do frontend se hospedado em domínio separado (ex.: https://alexsandsouza.github.io)
# Deixe vazio quando app + API estiverem no mesmo domínio Vercel (recomendado).
CORS_ORIGIN=

# Seed da conta administrativa (executar npm run seed:admin após preencher)
ADMIN_NAME=Administrador Digitar Pro
ADMIN_EMAIL=admin@digitarpro.local
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_AQUI

# Vercel: migrações IF NOT EXISTS no cold start (padrão: ligado na Vercel)
# RUN_MIGRATIONS_ON_BOOT=true
