# URL de conexão PostgreSQL
DATABASE_URL=postgres://postgres:SUA_SENHA_AQUI@localhost:5432/digitar_pro

# Porta do servidor HTTP + API
PORT=3000

# Origem do frontend se hospedado em domínio separado (ex.: https://alexsandsouza.github.io)
CORS_ORIGIN=

# Seed da conta administrativa (executar npm run seed:admin após preencher)
ADMIN_NAME=Administrador Digitar Pro
ADMIN_EMAIL=admin@digitarpro.local
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_AQUI
